{
  "manifest_version": 3,
  "name": "Plonker",
  "version": "0.1.1",
  "description": "Tracks your GeoGuessr rounds and teaches the metas you keep missing. Pulls tips from plonkit + learnablemeta.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.geoguessr.com/*",
    "https://qhudavmfhbumknqddgig.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Plonker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay/overlay.css",
        "src/overlay/overlay.js",
        "data/*.json"
      ],
      "matches": ["https://www.geoguessr.com/*"]
    }
  ]
}
